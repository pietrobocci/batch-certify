# Copy to .env and fill in — .env is gitignored, never commit it.

# RPC endpoint for Sepolia (free tier from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Private key of the deployer wallet (a THROWAWAY wallet with only
# Sepolia test ETH from a faucet — never a wallet holding real funds)
SEPOLIA_PRIVATE_KEY=0x...

# For source verification on https://sepolia.etherscan.io (free account)
ETHERSCAN_API_KEY=...
