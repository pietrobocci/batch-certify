node_modules/
artifacts/
cache/
coverage/
typechain-types/
# deployed.json is committed: once a contract is live on a public network its
# address is a fact about the project, not local configuration. A local redeploy
# rewrites the 31337 entry — `git checkout` the file when that dirties the tree.

# never commit secrets: RPC keys, private keys
.env

# frontend/src/generated/ is committed for the same reason: a build from a
# fresh clone must know the Sepolia address, otherwise the public demo has no
# contract to talk to.

# graphify: grafo locale e configurazione dell'assistente, non fanno parte del progetto
/graphify-out/
/.claude/
